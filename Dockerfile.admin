FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /admin ./cmd/admin

FROM alpine:3.20
RUN apk --no-cache add ca-certificates && adduser -D -u 1000 appuser
COPY --from=builder /admin /admin
COPY --from=builder /app/configs/ /configs/
USER appuser
EXPOSE 9000
ENTRYPOINT ["/admin"]
