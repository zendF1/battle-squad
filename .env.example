# Battle Squad - Environment Configuration Example

# Server settings (production: APP_ENV=production; see docs/deploy.md)
APP_ENV=development
API_PORT=8080
GAME_PORT=8081
APP_VERSION=1.0.0
PROTOCOL_VERSION=1

# Accept fake IAP purchase tokens (local testing only; ignored when APP_ENV=production)
IAP_MOCK_ENABLED=true

# QuickPlay may use every character and item without owning or consuming them
# (local testing only; ignored when APP_ENV=production)
DEV_UNLOCK_ALL=false

# PostgreSQL Database DSN
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/battlesquad?sslmode=disable

# Redis Cache/Registry settings
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security: cmd/api and cmd/game refuse this dev value (or any under 32 chars) in production
JWT_SECRET=super-secret-battle-squad-key-2026

# Connection pool tuning
DB_MAX_CONNS=50
DB_MIN_CONNS=10
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE=20

# Node Configuration (cmd/game: unique per game node; cmd/admin defaults to node-admin-1)
NODE_ID=node-game-1

# Admin dashboard (cmd/admin)
ADMIN_PORT=9000
# cmd/migrate creates the first dashboard login from these while admin_users is empty
# (password >= 12 chars; never changes an existing admin). Unset them after the first run.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Integration tests only: a throwaway Postgres (each test makes its own schema)
# TEST_POSTGRES_DSN=postgres://postgres:postgres@localhost:5440/battlesquad?sslmode=disable
# TEST_REDIS_ADDR=localhost:6379
